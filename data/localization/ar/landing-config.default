# ---------------------------------------------------- إعدادات الصفحة الرئيسية في STRANK (الميزة 14) -----------------------------
# (تبقى المفاتيح والقيم بالإنجليزية؛ هذه التعليقات فقط مترجمة.)
# القيم الممكنة:
#   focus arms days (أيام التركيز على الذراعين): أيام الأسبوع مفصولة بفواصل، بالاختصارات الإنجليزية (mon, tue, wed, thu, fri, sat, sun)
#   focus core days (أيام التركيز على الجذع): أيام الأسبوع مفصولة بفواصل، بالاختصارات الإنجليزية (mon, tue, wed, thu, fri, sat, sun)
#   focus lungs days (أيام التركيز على الرئتين): أيام الأسبوع مفصولة بفواصل، بالاختصارات الإنجليزية (mon, tue, wed, thu, fri, sat, sun)
#   focus legs days (أيام التركيز على الساقين): أيام الأسبوع مفصولة بفواصل، بالاختصارات الإنجليزية (mon, tue, wed, thu, fri, sat, sun)
# --------------------------------------------------------------------------------------------------------------------------------
focus arms days: mon,thu
focus core days: tue,fri
focus lungs days: mon,wed,fri
focus legs days: wed,sat
