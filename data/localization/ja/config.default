# ---------------------------------------------------- STRANK 設定 (全体) --------------------------------------------------------
# (キーと値は英語のままにしてください。翻訳されているのはこのコメントだけです。)
# 設定できる値:
#   language (言語): en, zh-Hans, hi, es, ar, fr, de, pt, ru, ja
#   font size (文字サイズ): 8, 9, 10, … 24 (小数なし) — または small, medium, large
#   accent color (アクセントカラー): #000000 → #FFFFFF
#   background color (背景色): #000000 → #FFFFFF
#   panel color (パネルの色): #000000 → #FFFFFF
#   text color (文字色): #000000 → #FFFFFF
#   muted color (控えめな色): #000000 → #FFFFFF
#   danger color (警告色): #000000 → #FFFFFF
#   ok color (成功色): #000000 → #FFFFFF

#   colorblind filter (色覚補助フィルター): none, protanopia, deuteranopia, tritanopia
#   screen reader mode (スクリーンリーダーモード): true, false
#   navbar alignment (ナビゲーションバーの位置): left, top
#   24hr (24時間表示): t, f  (t = 24時間制、f = 12時間制)
#   notifications enabled (通知を有効化): true, false
#   completion sounds enabled (完了音を有効化): true, false
#   logging (ログ記録): true, false
#   fullscreen (全画面表示): true, false
#   weight units (重量の単位): lbs, kgs
#   distance units (距離の単位): mi, km, m, yd, ft, in
#   onboarding completed (初回セットアップ完了): true, false
#   animation workout start (トレーニング開始アニメーション): true, false
#   animation click ripple (クリック波紋アニメーション): true, false
#   animation view slides (画面スライドアニメーション): true, false
#   animation content reveal (コンテンツ表示アニメーション): true, false
#   animation flyout fade (フライアウトのフェードアニメーション): true, false
#   animation elevated buttons (浮き上がるボタンのアニメーション): true, false
#   animation outline buttons (アウトラインボタンのアニメーション): true, false
#   animation accordions (アコーディオンのアニメーション): true, false
#   animation smooth card scroll (カードのスムーズスクロールアニメーション): true, false
# --------------------------------------------------------------------------------------------------------------------------------
language: ja
font size: 16
accent color: #328DF5
background color: #280F6B
panel color: #432331
text color: #D6EBFF
muted color: #71787F
danger color: #E35D6A
ok color: #3ECF8E
glow color: #1E3A5F
alert color: #C9A227

colorblind filter: none
screen reader mode: false
navbar alignment: top
24hr: f
notifications enabled: false
completion sounds enabled: true
logging: false
fullscreen: false
data directory: 
store path: 

weight units: lbs
distance units: mi
onboarding completed: true
animation workout start: true
animation click ripple: true
animation view slides: true
animation content reveal: true
animation flyout fade: true
animation elevated buttons: true
animation outline buttons: true
animation accordions: true
animation smooth card scroll: true
