{
  "name": "strank",
  "version": "0.3.1",
  "description": "Custom exercise ranking tracker",
  "main": "index.html",
  "node-main": "src/node-main.js",
  "window": {
    "title": "Strank",
    "icon": "assets/icon.png",
    "width": 1024,
    "height": 768,
    "min_width": 640,
    "min_height": 480
  },
  "single-instance": true,
  "chromium-args": "--disable-background-networking --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-component-update --disable-component-extensions-with-background-pages --disable-sync --disable-client-side-phishing-detection --disable-default-apps --disable-domain-reliability --disable-breakpad --disable-crash-reporter --disable-logging --disable-notifications --disable-permissions-api --disable-speech-api --disable-print-preview --disable-cloud-import --no-service-autorun --safebrowsing-disable-auto-update --safebrowsing-disable-download-protection --disable-features=TranslateUI,InterestFeedContentSuggestions,AudioServiceOutOfProcess,CertificateTransparencyComponentUpdater,AutofillServerCommunication,OptimizationHints,MediaRouter,DialMediaRouteProvider,ChromeWhatsNewUI,NetworkTimeServiceQuerying,CalculateNativeWinOcclusion,DnsOverHttps,UseDnsHttpsSvcb,UnsafeLegacyTLSVersion,BackForwardCache,GlobalMediaControls,ImprovedCookieControls,LazyLoad,DestroyProfileOnBrowserClose,SafeBrowsingEnhancedProtection,AcceptCHFrame,AutoDeElevate,HardwareMediaKeyHandling --disable-ipc-flooding-protection --no-pings --no-first-run --no-default-browser-check --metrics-recording-only --check-for-update-interval=31536000 --dns-over-https-mode=off --disable-quic --disable-webrtc --force-webrtc-ip-permission-check '--host-resolver-rules=MAP * ~NOTFOUND' '--proxy-server=http://127.0.0.1:9' '--proxy-bypass-list='",
  "scripts": {
    "start": "nw .",
    "dist": "node scripts/dist-win.js",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nw": "^0.92.0",
    "nw-builder": "^4.24.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "private": true,
  "dependencies": {
    "jszip": "^3.10.2"
  }
}
